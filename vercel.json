{
  "version": 2,
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type,Authorization,X-API-Key,Anthropic-Version,Anthropic-Beta"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:match*",
      "destination": "https://api.anthropic.com/:match*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "anthropicapi.itlol.cn"
        }
      ]
    },
    {
      "source": "/:match*",
      "destination": "https://api.search.brave.com/:match*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "braveapi.itlol.cn"
        }
      ]
    },
    {
      "source": "/:match*",
      "destination": "https://api.openai.com/:match*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "openapi.itlol.cn"
        }
      ]
    },
    {
      "source": "/:match*",
      "destination": "https://www.okx.com/:match*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "okxapi.itlol.cn"
        }
      ]
    },
    {
      "source": "/:match*",
      "destination": "https://api.coin.z.com/:match*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "gmoapi.itlol.cn"
        }
      ]
    },
    {
      "source": "/:match*",
      "destination": "https://api.openai.com/:match*"
    }
  ]
}